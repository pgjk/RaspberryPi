[Unit]
Description=Raspberry Pi Heating Control Service
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/househeating/RaspberryPi
ExecStart=/home/admin/househeating/RaspberryPi/venv/bin/python /home/admin/househeating/RaspberryPi/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
